# ============================================================
# SHelpDesk — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el `.env` al repositorio.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=helpdesk_db

# --- Usuario de BD de la aplicación (mínimo privilegio; NO superuser) ---
APP_DB_USER=helpdesk_app
APP_DB_PASSWORD=cambia_esto

# --- Backend (FastAPI) ---
# Para ejecución local; dentro de Docker el compose inyecta host "postgres".
DATABASE_URL=postgresql+asyncpg://helpdesk_app:cambia_esto@localhost:5432/helpdesk_db
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
N8N_CHAT_URL=http://localhost:5678/webhook/chat
N8N_URL=http://localhost:5678
# Modelo de embeddings del RAG (debe coincidir con la dimensión de embedding_vector)
EMBEDDING_MODEL=bge-m3
# API key que n8n envía (header X-API-Key) al callback /tickets/{id}/ai-analysis
AI_CALLBACK_KEY=cambia_esto
# Máximo de tickets que el coordinador puede asignar a un agente por día
MAX_TICKETS_AGENTE_DIA=3
OLLAMA_URL=http://localhost:11434

# Retención de respaldos automáticos (días) y mínimo de copias a conservar.
BACKUP_RETENCION_DIAS=30
BACKUP_MIN_CONSERVAR=5

# --- n8n ---
N8N_API_KEY=cambia_esto
N8N_DB_NAME=n8n_db
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambia_esto

# --- CORS (frontend en Vercel; separados por coma) ---
CORS_ORIGINS=http://localhost:8000

# --- Rate limiting / bloqueo de cuentas ---
# Detrás de un proxy (Vercel) todos comparten IP: el control real es por email.
LOGIN_MAX_POR_IP=200
LOGIN_MAX_POR_EMAIL=5
LOGIN_VENTANA_SEG=900
LOGIN_MAX_FALLOS=5
LOGIN_BLOQUEO_MIN=15
MFA_MAX_INTENTOS=5
MFA_VENTANA_SEG=300
# Déjalo en true solo si el backend está detrás de un proxy de confianza (Caddy/Cloudflare).
TRUST_PROXY=false

# --- Producción (docker-compose.prod.yml + Caddy) ---
API_DOMAIN=api.tudominio.com
ACME_EMAIL=tu-correo@dominio.com

# --- Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels) ---
CLOUDFLARE_TUNNEL_TOKEN=cambia_esto
