# Archivos de entorno y variables secretas
.env
.env.*
# La plantilla SÍ se versiona (no contiene secretos reales).
!.env.example
env/
*.yml

# Entornos virtuales de Python
venv/
.venv/

# Base de datos y datos locales
basededatos/
db_logic.sql
*.sql
# El esquema y los scripts de BD SÍ se versionan: permiten replicar la base
# en otro equipo y controlar los cambios de esquema (migraciones idempotentes).
database/*
!database/db_logic.sql
!database/seed_usuarios.sql
!database/mock_tickets_resueltos.sql
!database/migraciones/
!database/migraciones/*.sql

# --- Python / Bytecode ---
__pycache__/
*.py[cod]
*$py.class
test_hash.py
database.py

# --- Bases de datos locales / Sqlite ---
*.sqlite
*.sqlite3
*.db

# --- Archivos del Sistema / Editores ---
.DS_Store
thumbs.db
.vscode/
.idea/

# --- Logs y Archivos Temporales ---
*.log
*.tmp
comando
comando.txt

# ---------------------------------------------------------------------------
# Contexto para agentes de codificación: NO se publica en GitHub.
# ---------------------------------------------------------------------------
AGENTS.md

# ---------------------------------------------------------------------------
# Excepciones: archivos SIN secretos imprescindibles para desplegar/producir.
# (docker-compose.yml y backend/database.py no contienen credenciales: leen
#  las variables del .env, que ese sí sigue ignorado.)
# ---------------------------------------------------------------------------
!docker/docker-compose.yml
!docker/docker-compose.prod.yml
!docker/docker-compose.cloudflared.yml
!backend/database.py
# Integración continua (YAML de GitHub Actions)
!.github/workflows/*.yml
!.github/dependabot.yml
.git